# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# 1. Database Connection (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Dapat menggunakan database lokal, Supabase, Neon, Railway, atau provider PostgreSQL lainnya.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# 2. Authentication & JWT Session Secrets
# Generate random 64-character secret string (misal: openssl rand -base64 32)
AUTH_SECRET="your-super-secure-random-secret-key-min-32-chars"
SESSION_COOKIE_NAME="portfolio_admin_session"

# 3. Application Base URL
# Di lokal: http://localhost:3000
# Di production: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 4. Vercel Blob Storage (Cloud Storage for Media Uploads)
# Wajib diisi saat deployment di Vercel atau untuk mengaktifkan cloud storage di lokal.
# Cara mendapatkan token:
# 1. Buka Vercel Dashboard -> Pilih Project -> Tab "Storage"
# 2. Klik "Create Database" -> Pilih "Blob"
# 3. Hubungkan (Connect) ke Project Anda. Environment variable BLOB_READ_WRITE_TOKEN
#    akan terisi otomatis di Vercel, atau copy token tersebut ke file .env lokal.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# 5. LibreTranslate Auto-Translation Configuration
# Jalankan lokal via Docker: docker run -ti --rm -p 5000:5000 libretranslate/libretranslate --load-only id,en
# Atau gunakan self-hosted / cloud instance LibreTranslate Anda.
LIBRETRANSLATE_URL="http://localhost:5000/translate"
LIBRETRANSLATE_API_KEY=""
